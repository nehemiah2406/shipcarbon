# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection. Local server for development; in Phase 6 use the Atlas connection string
# (mongodb+srv://<user>:<password>@<cluster>/...) and set it as an environment variable on Render.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=shipcarbon

# Extra websites allowed to call the API from a browser (CORS), comma-separated, no trailing slash.
# http://localhost:5173 (the local Vite dev server) is always allowed.
# Example for later: FRONTEND_ORIGINS=https://shipcarbon.vercel.app
FRONTEND_ORIGINS=
